{
  "compilerOptions": {
  "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
  "esModuleInterop": true,
  "allowSyntheticDefaultImports": true,
  "module": "esnext",
  "moduleResolution": "node",
  "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "functions/.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
